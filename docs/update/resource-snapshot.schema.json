{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agentatelier/schemas/resource-snapshot-v1.json",
  "title": "AgentAtelierR canonical complete resource snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "asset_key_id", "canonicalization", "compatible_runtime_ids", "objects",
    "resource_api_version", "schema_version", "snapshot_id"
  ],
  "properties": {
    "asset_key_id": { "$ref": "#/$defs/identifier" },
    "canonicalization": { "const": "aar-cjson-v1" },
    "compatible_runtime_ids": {
      "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "objects": {
      "type": "array", "maxItems": 100000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256", "size", "urls"],
        "properties": {
          "path": {
            "type": "string", "minLength": 1, "maxLength": 512,
            "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:\\u0000-\\u001f\\u007f])(?!.*\\/$).+$"
          },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size": { "type": "integer", "minimum": 1, "maximum": 2147483648 },
          "urls": {
            "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
            "items": { "type": "string", "format": "uri", "pattern": "^https://" }
          }
        }
      }
    },
    "resource_api_version": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
    "schema_version": { "const": 1 },
    "snapshot_id": { "$ref": "#/$defs/identifier" }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" }
  }
}
